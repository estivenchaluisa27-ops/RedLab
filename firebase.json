{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8081
    }
  },
  "hosting": {
    "site": "lab-redes-turnos",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.js",
      "vitest.config.js",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "tests/**",
      "**/*.exe",
      "**/*.apk",
      "firestore-debug.log",
      "android/**",
      "www/**",
      "redlab-push-server/**",
      "scripts/**",
      "capacitor.config.json",
      "AGENTS.md",
      ".agents/**",
      "plan.md",
      ".codebase-memory/**",
      ".github/**"
    ],
    "headers": [
      { "regex": "(^/index\\.html$)|(^/$)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
    ]
  }
}
