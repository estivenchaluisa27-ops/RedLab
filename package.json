{
  "name": "redlab",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "lint": "eslint src/",
    "build:css": "tailwindcss -i src/styles/tailwind-input.css -o styles.css --minify",
    "build:app": "node scripts/build-app.js",
    "cap:sync": "npm run build:app && npx cap sync android",
    "precommit": "npm run build:css && git add styles.css"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2"
  }
}
