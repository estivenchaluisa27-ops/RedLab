rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // FUNCIONES AUXILIARES
    // ==============================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isProfessor() {
      return exists(/databases/$(database)/documents/professors/$(request.auth.token.email));
    }

    function isStudent() {
      return exists(/databases/$(database)/documents/student_directory/$(request.auth.token.email));
    }

    function currentStudentDirectory() {
      return get(/databases/$(database)/documents/student_directory/$(request.auth.token.email));
    }

    function currentStudentGroupName() {
      let sd = currentStudentDirectory().data;
      return get(/databases/$(database)/documents/courses/$(sd.courseId)/groups/$(sd.groupId)).data.name;
    }

    function isValidReservationCreate() {
      let r = request.resource.data;
      return r.date is string
          && r.date != ''
          && r.hour is number
          && r.status == 'pending'
          && r.userId == request.auth.uid
          && r.userId is string
          && r.userId != ''
          && r.groupName is string
          && r.groupName != ''
          && r.courseId is string
          && r.courseId != ''
          && r.courseId == currentStudentDirectory().data.courseId
          && r.groupName == currentStudentGroupName()
          && r.attendanceDetail == null;
    }

    // ==============================
    // ADMINISTRADORES
    // ==============================
    match /admins/{email} {
      allow read: if isSignedIn() && (isAdmin() || isProfessor() || email == request.auth.token.email);
      allow write: if isSignedIn() && isAdmin();
    }

    // ==============================
    // PROFESORES
    // ==============================
    match /professors/{email} {
      allow read: if isSignedIn() && (isAdmin() || isProfessor() || email == request.auth.token.email);
      allow write: if isSignedIn() && isAdmin();
    }

    // ==============================
    // DIRECTORIO ESTUDIANTIL
    // ==============================
    match /student_directory/{email} {
      allow read: if isSignedIn() && (
        isAdmin()
        || email == request.auth.token.email
      );
      allow write: if isSignedIn() && isAdmin();
    }

    // ==============================
    // CURSOS
    // ==============================
    match /courses/{courseId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (isProfessor() && resource.data.professorEmail == request.auth.token.email)
        || (isStudent() && currentStudentDirectory().data.courseId == courseId)
      );
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        isAdmin()
        || (isProfessor() && resource.data.professorEmail == request.auth.token.email)
      );
      allow delete: if isSignedIn() && isAdmin();

      // ==============================
      // GRUPOS (subcolección)
      // ==============================
      match /groups/{groupId} {
        allow read: if isSignedIn() && (
          isAdmin()
          || (isProfessor() && get(/databases/$(database)/documents/courses/$(courseId)).data.professorEmail == request.auth.token.email)
          || (isStudent() && get(/databases/$(database)/documents/student_directory/$(request.auth.token.email)).data.courseId == courseId)
        );
        allow write: if isSignedIn() && (
          isAdmin()
          || (isProfessor() && get(/databases/$(database)/documents/courses/$(courseId)).data.professorEmail == request.auth.token.email)
        );
      }
    }

    // ==============================
    // RESERVAS
    // ==============================
    match /reservations/{reservationId} {

      // LECTURA: Admins todo; profesores ven ocupación global (approved/blocked) + pending de sus cursos; estudiantes solo su curso + bloqueos
      allow read: if isSignedIn() && (
        isAdmin()
        || (isProfessor() && (
          resource.data.status == 'blocked'
          || resource.data.status == 'approved'
          || (resource.data.courseId != null
              && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.professorEmail == request.auth.token.email)
        ))
        || (isStudent() && (
          resource.data.status == 'blocked'
          || resource.data.courseId == currentStudentDirectory().data.courseId
        ))
      );

      // CREACIÓN: Estudiantes autenticados con validación estricta (pending)
      allow create: if isSignedIn()
          && isStudent()
          && isValidReservationCreate()
          && request.resource.data.status == 'pending';

      // CREACIÓN: Admin puede crear bloqueos manuales/recurrentes
      allow create: if isAdmin()
          && request.resource.data.keys().hasAll(['status','createdAt','date','hour'])
          && request.resource.data.status == 'blocked'
          && request.resource.data.userId == 'ADMIN';

      // ACTUALIZACIÓN: Solo admin/profesor puede cambiar status/attendanceDetail
      allow update: if isSignedIn() && (
        isAdmin()
        || (isProfessor()
            && resource.data.courseId != null
            && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.professorEmail == request.auth.token.email)
      );

      // ELIMINACIÓN: Admin elimina cualquier; estudiante elimina sus propias reservas pendientes o aprobadas
      allow delete: if isSignedIn() && (
        isAdmin()
        || (isStudent()
            && resource.data.userId == request.auth.uid
            && resource.data.status in ['pending', 'approved'])
      );
    }

    // ==============================
    // NOTIFICACIONES IN-APP (historial del estudiante)
    // ==============================
    match /notifications/{notificationId} {

      // LECTURA: el estudiante solo ve sus propias notificaciones.
      // El motor exige que la query restrinja el conjunto potencial a userId == auth.uid
      // (una query sin ese filtro o hacia otro userId falla automáticamente).
      allow read: if isSignedIn()
          && isStudent()
          && resource.data.userId == request.auth.uid;

      // CREACIÓN: la registra quien ejecuta la acción (admin/profesor para eventos del flujo; el estudiante solo las propias de tipo solicitada/cancelada)
      allow create: if isSignedIn()
          && (isAdmin() || isProfessor()
              || (isStudent()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.type in ['solicitada', 'cancelada']))
          && request.resource.data.keys().hasAll(['userId','type','date','hour','read','createdAt'])
          && request.resource.data.type in ['solicitada','aprobada','rechazada','cancelada','bloqueada']
          && request.resource.data.userId is string
          && request.resource.data.date is string
          && request.resource.data.hour is int
          && request.resource.data.read == false;

      // ACTUALIZACIÓN: el estudiante solo puede marcar como leída (diff valida que nada más cambie)
      allow update: if isSignedIn()
          && isStudent()
          && resource.data.userId == request.auth.uid
          && request.resource.data.read == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isSignedIn() && isAdmin();
    }

    // ==============================
    // TOKENES DE DISPOSITIVO FCM
    // ==============================
    // Cada usuario autenticado puede leer/escribir solo su propio token
    match /device_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ==============================
    // DENEGAR TODO LO DEMÁS
    // ==============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
