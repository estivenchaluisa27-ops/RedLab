# .env.example — copia a .env y rellena con valores reales
# NUNCA commitear .env con valores reales — solo Fly.io secrets en produccion

# Service account JSON de Firebase (pegar todo el JSON en una linea)
# Obtenido desde: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# El archivo service-account.json YA esta en este directorio (gitignored).
# Para desarrollo local, el servidor lo lee automaticamente si existe.
# Para Fly.io produccion, cargar como secret:
#   fly secrets set FIREBASE_SERVICE_ACCOUNT=@service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Project ID de Firebase
FIREBASE_PROJECT_ID=lab-redes-turnos

# Puerto del servidor (Fly.io lo gestiona automaticamente en produccion via internal_port en fly.toml)
PORT=3000
